# /etc/obsidian-mcp.env  (chmod 600, owned by root)
OBSIDIAN_VAULT_PATH=/srv/vault
# Listen on loopback only; a reverse proxy (tailscale serve, Caddy, ...) terminates TLS and proxies to it.
OBSIDIAN_MCP_HOST=127.0.0.1
OBSIDIAN_MCP_PORT=8787
# openssl rand -hex 32
OBSIDIAN_MCP_TOKEN=
# Host header the reverse proxy forwards (your public hostname).
OBSIDIAN_MCP_ALLOWED_HOSTS=mcp.example.com,localhost,127.0.0.1
# Comma-separated folders the MCP may write to. Empty = whole vault.
OBSIDIAN_MCP_WRITE_PATHS=
# Never writable (basename match). Default: CLAUDE.md,AGENTS.md
#OBSIDIAN_MCP_PROTECTED_NAMES=CLAUDE.md,AGENTS.md
# Folders hidden from the MCP entirely.
#OBSIDIAN_MCP_IGNORE_PATHS=
#OBSIDIAN_MCP_READONLY=1
